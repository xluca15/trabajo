# Cadena de conexión de Neon (Dashboard → Connect). Usá la URL "pooled".
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública de la app (en Vercel: https://tu-dominio.vercel.app)
BETTER_AUTH_URL=http://localhost:3000
